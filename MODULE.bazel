module(name = 'gazelle_harness', version = '0.0.1')

# Gazelle itself: provides gazelle_binary and the Go and proto languages
bazel_dep(name = 'gazelle', version = '2.0.0-beta.2')

# Needed for the golden py_test in step 2
bazel_dep(name = 'rules_python', version = '0.40.0')
bazel_dep(name = 'gazelle_kotlin', version = '0.0.1')
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = 'rules_python_gazelle_plugin', version = '0.40.0')
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")

# Pinned by commit so a clean checkout (CI, new machine) resolves without a sibling directory.
# To develop against a local checkout without editing this file, add to .bazelrc.user:
#   common --override_module=gazelle_kotlin=../gazelle-kotlin
git_override(
    module_name = 'gazelle_kotlin',
    remote = 'https://github.com/tazzledazzle/gazelle-kotlin.git',
    commit = '14351133e6e011c98fa534db6bdf899c09b13432',
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")

python = use_extension('@rules_python//python/extensions:python.bzl', 'python')
# Register one explicit interpreter; newer rules_python versions expect this
python.toolchain(python_version = '3.12', is_default = True)
