# This repo is Bzlmod-only; the WORKSPACE variant lives inside individual corpus repos
common --enable_bzlmod
common --noenable_workspace
# Print test output only when a test fails
test --test_output=errors
# Reuse downloaded artifacts across clean builds
build --disk_cache=~/.cache/bazel-disk
# Per-developer overrides (for example --override_module for a local gazelle-kotlin checkout)
try-import %workspace%/.bazelrc.user

# Hermetic Java: the GitHub runner's default JDK is 25 while javac runs on rules_java's remote JDK 21, so building
# protobuf's Java (pulled in by the Java Gazelle extension) failed with "Java 21 runtime ... not recent enough for Java 25".
# Pin both the compile target and the runtime to 21 for the target and exec configurations.
build --java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21
